{
  "name": "clown-md",
  "description": "CLOWN-MD 🤡 - High performance WhatsApp bot by KAVIDU DILAKSHANA",
  "keywords": ["clown-md", "whatsapp-bot", "baileys", "clown-md", "kavidu-md"],
  "repository": "https://github.com/GlobalTechInfo/MEGA-MDX",
  "stack": "container",
  "env": {
    "SESSION_ID": {
      "description": "Your session ID (get it by running the bot locally first)",
      "required": true,
      "value": ""
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number with country code (e.g. 94704296653)",
      "required": true,
      "value": "94704296653"
    },
    "MONGO_URL": {
      "description": "MongoDB URL for persistent storage (recommended for Heroku)",
      "required": false,
      "value": ""
    },
    "POSTGRES_URL": {
      "description": "PostgreSQL URL for persistent storage",
      "required": false,
      "value": ""
    },
    "MYSQL_URL": {
      "description": "MySQL URL for persistent storage",
      "required": false,
      "value": ""
    },
    "BOT_NAME": {
      "description": "Your bot name",
      "required": false,
      "value": "CLOWN-MD 🤡"
    },
    "BOT_OWNER": {
      "description": "Owner display name",
      "required": false,
      "value": "KAVIDU DILAKSHANA"
    },
    "PREFIXES": {
      "description": "Command prefixes separated by comma (e.g. .,!,/)",
      "required": false,
      "value": "."
    },
    "PACKNAME": {
      "description": "Sticker pack name",
      "required": false,
      "value": "CLOWN-MD 🤡"
    },
    "COMMAND_MODE": {
      "description": "Bot mode: public or private",
      "required": false,
      "value": "public"
    },
    "TIMEZONE": {
      "description": "Your timezone (e.g. Asia/Colombo)",
      "required": false,
      "value": "Asia/Colombo"
    },
    "REMOVEBG_KEY": {
      "description": "Remove.bg API key for background removal",
      "required": false,
      "value": ""
    }
  },
  "buildpacks": [
    { "url": "heroku/nodejs" },
    { "url": "https://github.com/DuckyTeam/heroku-buildpack-imagemagick.git" },
    { "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest" },
    { "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git" }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
